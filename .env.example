# InsForge backend connection.
# Get these with:
#   npx @insforge/cli link --project-id <your-project-id>
#   npx @insforge/cli secrets get ANON_KEY
# The anon key is safe to expose to the browser; row-level security controls access.
NEXT_PUBLIC_INSFORGE_URL="https://<appkey>.<region>.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY="anon_..."

# Public origin of this app, used for OAuth redirects.
NEXT_PUBLIC_APP_URL="https://www.webtotalsolution.com"
