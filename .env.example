# InsForge backend connection — these are the ONLY two variables the app needs.
#
# Get them with:
#   npx @insforge/cli link --project-id <your-project-id>
#   npx @insforge/cli secrets get ANON_KEY
#
# The anon key is designed to be public (it ships to the browser). Row-level
# security in the database, not secrecy of this key, is what protects your data.
# Never put the admin API key (ik_...) in a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_INSFORGE_URL="https://<appkey>.<region>.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY="anon_..."

# Optional: where enquiry forms deliver.
#   live       sends to the capture-lead function (default for production builds)
#   mock       never contacts the backend and shows the success state (default in `next dev`)
#   mock-fail  never contacts the backend and shows the failure state
# Use `mock` for a preview build so reviewing the form cannot send a real enquiry.
# NEXT_PUBLIC_LEAD_CAPTURE_MODE="mock"

# Dedicated Google Ads landing page: /website-design-development
# Server-only mode: dev defaults to mock; production defaults to live.
# WEBSITE_ENQUIRY_MODE="mock"
# WEBSITE_ENQUIRY_MODE="mock-fail"
# Optional server-only overrides for the existing capture-lead integration.
# WEBSITE_LEAD_CAPTURE_URL="https://<project>.insforge.app/functions/capture-lead"
# WEBSITE_LEAD_CAPTURE_KEY="<function-scoped-key>"
# Public measurement IDs. Empty values leave measurement disabled.
# NEXT_PUBLIC_GOOGLE_ADS_ID="AW-<digits>"
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL="<conversion-action-label>"
# NEXT_PUBLIC_GA4_ID="G-<measurement-id>"
